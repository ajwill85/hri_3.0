# Environment Variables for HRI 3.0

# News API Endpoint
# Replace with your actual API Gateway endpoint
VITE_API_ENDPOINT=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/prod/news

# URL Shortener API Endpoint
# Replace with your actual API Gateway endpoint after deploying the Lambda function
VITE_SHORTENER_API_ENDPOINT=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/prod/share
